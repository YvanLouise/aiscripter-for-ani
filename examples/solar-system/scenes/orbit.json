{
  "id": "orbit",
  "name": "Earth's Orbit",
  "durationFrames": 150,
  "layers": [
    {
      "id": "orbit-stars", "name": "Starfield WebGL", "type": "custom", "startFrame": 0, "endFrame": 150,
      "x": 960, "y": 540, "width": 960, "height": 540, "scaleX": 2, "scaleY": 2, "rotation": 0, "opacity": 1,
      "visible": true, "keyframes": {}, "script": "scripts/starfield.mjs", "renderer": "webgl2",
      "params": { "density": 0.5, "blue": 0.85 }
    },
    {
      "id": "orbit-guide", "name": "Orbit Guide", "type": "svg", "startFrame": 0, "endFrame": 150,
      "x": 960, "y": 600, "width": 1180, "height": 760, "scaleX": 1, "scaleY": 1, "rotation": 0, "opacity": 0.58,
      "visible": true, "keyframes": {}, "expressions": { "opacity": "base + 0.06 * sin(2 * pi * frame / 150)" },
      "asset": "assets/orbit-guide.svg"
    },
    {
      "id": "orbit-sun", "name": "Sun", "type": "image", "startFrame": 0, "endFrame": 150,
      "x": 960, "y": 600, "width": 420, "height": 420, "scaleX": 1, "scaleY": 1, "rotation": 0, "opacity": 1,
      "visible": true, "keyframes": {}, "expressions": {
        "scaleX": "base + 0.025 * sin(2 * pi * frame / 90)",
        "scaleY": "base + 0.025 * sin(2 * pi * frame / 90)"
      }, "asset": "assets/sun.svg"
    },
    {
      "id": "orbit-earth", "name": "Earth", "type": "image", "startFrame": 0, "endFrame": 150,
      "x": 960, "y": 600, "width": 240, "height": 240, "scaleX": 1, "scaleY": 1, "rotation": 0, "opacity": 1,
      "visible": true, "keyframes": {}, "expressions": {
        "x": "base + 500 * cos(2 * pi * frame / 150)",
        "y": "base + 300 * sin(2 * pi * frame / 150)",
        "scaleX": "0.85 + 0.15 * sin(2 * pi * frame / 150)",
        "scaleY": "0.85 + 0.15 * sin(2 * pi * frame / 150)",
        "rotation": "base + 8 * sin(2 * pi * frame / 150)"
      },
      "asset": "assets/earth.svg"
    },
    {
      "id": "orbit-title", "name": "Orbital motion", "type": "text", "startFrame": 0, "endFrame": 150,
      "x": 960, "y": 130, "width": 1300, "height": 110, "scaleX": 1, "scaleY": 1, "rotation": 0, "opacity": 1,
      "visible": true, "keyframes": { "opacity": [
        { "frame": 0, "value": 0, "easing": [0.22, 1, 0.36, 1] },
        { "frame": 20, "value": 1 }
      ] }, "text": "One year, one orbit", "fontSize": 78, "fontFamily": "Arial", "color": "#ffffff"
    }
  ]
}
