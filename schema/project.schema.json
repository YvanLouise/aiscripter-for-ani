{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiscripter.local/schema/project-v2",
  "type": "object",
  "required": ["formatVersion", "id", "name", "width", "height", "fps", "scenes"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "scenes": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "file"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "file": { "type": "string", "pattern": "^scenes/[A-Za-z0-9_-]+\\.json$" } }
    } },
    "audioTracks": { "type": "array", "items": { "type": "object", "required": ["id", "name", "clips"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" },
        "clips": { "type": "array", "items": { "type": "object", "required": ["id", "asset", "startFrame", "sourceInFrame", "durationFrames", "volume"], "additionalProperties": false,
          "properties": { "id": { "type": "string", "minLength": 1 }, "asset": { "type": "string", "minLength": 1 },
            "startFrame": { "type": "integer", "minimum": 0 }, "sourceInFrame": { "type": "integer", "minimum": 0 },
            "durationFrames": { "type": "integer", "minimum": 1 }, "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "muted": { "type": "boolean" }, "loop": { "type": "boolean" },
            "fadeInFrames": { "type": "integer", "minimum": 0 }, "fadeOutFrames": { "type": "integer", "minimum": 0 } } } } } } }
  }
}
