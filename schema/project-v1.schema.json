{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiscripter.local/schema/project-v1",
  "type": "object",
  "required": ["formatVersion", "id", "name", "width", "height", "fps", "scenes"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "scenes": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "file"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "file": { "type": "string", "pattern": "^scenes/[A-Za-z0-9_-]+\\.json$" } }
    } }
  }
}
