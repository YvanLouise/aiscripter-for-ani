{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiscripter.local/schema/scene-v2",
  "type": "object",
  "required": ["id", "name", "durationFrames", "layers"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "durationFrames": { "type": "integer", "minimum": 1 },
    "clip": { "type": "object", "required": ["inFrame", "outFrame"], "additionalProperties": false,
      "properties": { "inFrame": { "type": "integer", "minimum": 0 }, "outFrame": { "type": "integer", "minimum": 1 } } },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
  },
  "$defs": {
    "keyframe": { "type": "object", "required": ["frame", "value"], "additionalProperties": false,
      "properties": { "frame": { "type": "integer", "minimum": 0 }, "value": { "type": ["number", "string"] },
        "easing": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "layer": { "type": "object", "required": ["id", "name", "type", "startFrame", "endFrame", "x", "y", "width", "height", "scaleX", "scaleY", "rotation", "opacity", "visible", "keyframes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" },
        "type": { "enum": ["text", "shape", "image", "svg", "video", "audio", "model3d", "custom"] },
        "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 1 },
        "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
        "scaleX": { "type": "number" }, "scaleY": { "type": "number" }, "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" },
        "keyframes": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/keyframe" } } },
        "expressions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "bindings": { "type": "object", "additionalProperties": { "type": "object", "required": ["asset", "path"], "additionalProperties": false,
          "properties": { "asset": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1, "maxLength": 256 } } } },
        "text": { "type": "string" }, "fontSize": { "type": "number", "exclusiveMinimum": 0 }, "fontFamily": { "type": "string" },
        "fontWeight": { "type": "number", "minimum": 100, "maximum": 900 }, "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "letterSpacing": { "type": "number" }, "textAlign": { "enum": ["left", "center", "right"] },
        "textStrokeColor": { "type": "string" }, "textStrokeWidth": { "type": "number", "minimum": 0 },
        "color": { "type": "string" }, "shape": { "enum": ["rect", "ellipse", "line", "polygon", "path"] },
        "sides": { "type": "integer", "minimum": 3, "maximum": 64 }, "pathData": { "type": "string" },
        "strokeColor": { "type": "string" }, "strokeWidth": { "type": "number", "minimum": 0 },
        "cornerRadius": { "type": "number", "minimum": 0 }, "shadowColor": { "type": "string" }, "shadowBlur": { "type": "number", "minimum": 0 },
        "asset": { "type": "string" }, "mediaFit": { "enum": ["stretch", "contain", "cover"] },
        "crop": { "type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false,
          "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } },
        "playbackRate": { "type": "number", "exclusiveMinimum": 0 }, "mediaInFrame": { "type": "integer", "minimum": 0 },
        "mask": { "type": "string" }, "blendMode": { "enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten", "difference", "add"] },
        "blur": { "type": "number", "minimum": 0 }, "brightness": { "type": "number", "minimum": 0 }, "saturation": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }, "muted": { "type": "boolean" },
        "loop": { "type": "boolean" }, "fadeInFrames": { "type": "integer", "minimum": 0 }, "fadeOutFrames": { "type": "integer", "minimum": 0 },
        "modelScale": { "type": "number", "exclusiveMinimum": 0 },
        "modelYaw": { "type": "number" }, "modelPitch": { "type": "number" }, "modelRoll": { "type": "number" },
        "cameraDistance": { "type": "number", "exclusiveMinimum": 0 },
        "cameraFov": { "type": "number", "exclusiveMinimum": 0, "maximum": 179 },
        "lightIntensity": { "type": "number", "minimum": 0 },
        "script": { "type": "string" }, "renderer": { "enum": ["2d", "webgl2"] },
        "params": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } }
      }
    }
  }
}
